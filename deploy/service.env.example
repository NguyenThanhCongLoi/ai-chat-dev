# Copy to service.env (ignored by Git). Never commit real secrets.
DOCS_USERNAME=admin
# Keep the OLD value to decrypt restored CMS credentials.
DOCS_PASSWORD=
LLM_API_BASE=https://gateway.avibi.ai/v1
LLM_MODEL=openai/gpt-4.1-mini
LLM_API_KEY=
OPENAI_MODERATION_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
MODERATION_MODEL=
CORS_ORIGINS=http://localhost:8000
BUILD_VERSION=selfhost-dev
DEMO_AUTH_ENABLED=false
CHAT_TRANSPORT=direct
# GPU features are preserved in code but not migrated or enabled in this CPU release.
GROUP_ROUTER_MODE=local
GROUP_ROUTER_TRANSPORT=http
REACTION_GENERATOR_MODE=disabled
# default: existing/default images; direct: call the configured CMS image provider on this host.
AVATAR_GENERATOR_MODE=default
