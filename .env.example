APP_ENV=development
DATA_DIR=./data
DATABASE_URL=
MODAL_APP_NAME=character-chat
MODAL_VOLUME_NAME=character-chat-data
MODAL_GPU=L4
LLM_PROVIDER=api
LLM_API_BASE=https://gateway.avibi.ai/v1
LLM_MODEL=openai/gpt-4.1-mini
LLM_FALLBACK_MODEL=zenlayer/gpt-5-nano
MODERATION_MODEL=zenlayer/gpt-5-nano
# Optional first moderation layer. Uses OpenAI's free Moderation endpoint.
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_API_BASE=https://api.openai.com/v1
DOCS_USERNAME=
DOCS_PASSWORD=
# Keep the real value in .env locally or in the Modal secret named character-chat-llm.
AIMP_API_KEY=
LLM_MAX_MODEL_LEN=8192
LLM_TEMPERATURE=0.77
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
ENABLE_RERANKER=false
MAX_GROUP_RESPONSES=2
MEMORY_RETRIEVAL_TOP_K=8
KNOWLEDGE_RETRIEVAL_TOP_K=8


# Optional TypeSafe Jev: fill only the key to enable decisions automatically.
# Key in environment takes priority over the encrypted CMS API-base key.
JEV_API_KEY=
JEV_ENABLED=true
JEV_MODEL=jev-latest
JEV_API_BASE=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=5
JEV_ROUTING_ENABLED=true
JEV_MODERATION_ENABLED=true
JEV_EMOTION_ENABLED=true

JEV_LANGUAGE_ENABLED=true

# Temporary product scope: only system characters are public/selectable in new Worlds.
COMMUNITY_CHARACTER_PUBLICATION_ENABLED=false
WORLD_SYSTEM_CHARACTERS_ONLY=true

# Optional Selene World prototype; story CMS at /worlds/admin.
WORLD_DEMO_ENABLED=false
# Narrator Voice IDs are stored in World CMS. Character voice stays in normal Chat CMS.

# Eight-chapter Selene World engine. WORLD_DEMO_ENABLED must also be true.
WORLD_ADVENTURE_ENABLED=true
